table Station
	lineageTag: e756da14-1ee9-2345-8134-771457d7e0e9

	column station_id
		dataType: string
		isHidden
		lineageTag: 9f82e43e-9ef6-727f-7442-613c9e1e601d
		summarizeBy: none
		sourceColumn: station_id

		annotation SummarizationSetBy = Automatic

	column Station
		dataType: string
		lineageTag: a4141e91-f820-f193-ffab-056220834262
		summarizeBy: none
		sourceColumn: name

		annotation SummarizationSetBy = Automatic

	column lat
		dataType: double
		isHidden
		formatString: 0.0000
		lineageTag: 15854709-748e-c3a8-690e-333bd61bb06d
		summarizeBy: none
