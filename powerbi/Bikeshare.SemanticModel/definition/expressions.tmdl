/// Carpeta local (con barra final) o URL raw de GitHub (con barra final) donde están los CSV.
expression DataPath =
		"https://raw.githubusercontent.com/jorvalfe6-byte/bikeshare-sql-analytics/main/powerbi/data/" meta [
			IsParameterQuery = true,
			Type = "Text",
			IsParameterQueryRequired = true
		]
	lineageTag: 8b25e6aa-e15e-4326-0d55-4bededb49b0e

	annotation PBI_ResultType = Text
